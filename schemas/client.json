{
  "type": "object",
  "properties": {
    "constitution": {
      "type": "string",
      "title": "Constitution",
      "enum": ["proprietorship", "partnership", "llp", "pvt_ltd", "public_ltd", "trust", "huf"]
    },
    "client_type": {
      "type": "string",
      "title": "Client type",
      "enum": ["regular", "one_time"],
      "default": "regular"
    },
    "registration_no": {
      "type": "string",
      "title": "Partnership deed / registration number",
      "maxLength": 50
    },
    "trust_reg_no": {
      "type": "string",
      "title": "Trust registration number (trusts only)",
      "maxLength": 50
    }
  },
  "required": ["constitution"],
  "allOf": [
    {
      "if": { "required": ["constitution"], "properties": { "constitution": { "const": "trust" } } },
      "then": { "required": ["trust_reg_no"] }
    }
  ]
}
