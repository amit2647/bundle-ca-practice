{
  "type": "object",
  "properties": {
    "reference": {
      "type": "string",
      "title": "Reference number",
      "maxLength": 60
    },
    "letter_date": {
      "type": "string",
      "format": "date",
      "title": "Date of letter"
    },
    "assessment_year": {
      "type": "string",
      "title": "Assessment year",
      "pattern": "^[0-9]{4}-[0-9]{2}$"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "title": "Due date of the report"
    },
    "turnover": {
      "type": "number",
      "minimum": 0,
      "title": "Turnover / gross receipts"
    },
    "fee": {
      "type": "number",
      "minimum": 0,
      "title": "Audit fee"
    },
    "form": {
      "type": "string",
      "title": "Audit report form",
      "enum": [
        "3CA",
        "3CB"
      ],
      "default": "3CB"
    },
    "within_limit": {
      "type": "boolean",
      "title": "Within the 60 tax-audit limit",
      "default": true
    }
  },
  "required": [
    "reference",
    "letter_date",
    "assessment_year",
    "fee"
  ]
}
